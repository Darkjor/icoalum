# Copia este archivo a .env.local y llena los valores. Nunca subas .env.local.
# Ninguna variable es obligatoria: sin ellas el sitio compila y los formularios
# funcionan en modo degradado (no envían ni guardan nada).

# --- Correo (Resend), solo servidor ---
RESEND_API_KEY=
# Destinatario(s) de cotizaciones y contacto, separados por coma. Default: presupuestos2@icoalum.net
LEADS_TO_EMAIL=
# Remitente. Default: Ico Alum <onboarding@resend.dev> hasta verificar el dominio en Resend
LEADS_FROM_EMAIL=

# --- Base de datos y planos (Supabase), solo servidor. NUNCA con prefijo NEXT_PUBLIC_ ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Públicas (van al navegador) ---
NEXT_PUBLIC_SITE_URL=
# Solo dígitos con lada de país, ej. 5213312345678. Vacío = sin botón de WhatsApp
NEXT_PUBLIC_WHATSAPP=
# Medición GA4 (solo carga tras aceptar cookies)
NEXT_PUBLIC_GA_ID=
